# Шаблон .env для docker-compose.yml на сервере (в отличие от
# backend/.env.example, который для локальной разработки на SQLite).
# Скопировать в .env рядом с docker-compose.yml и заполнить реальными
# значениями.

SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=example.com
# Схема + домен, без пути - см. README про SECURE_PROXY_SSL_HEADER/nginx.
CSRF_TRUSTED_ORIGINS=https://example.com

# Демо-режим: имена и контакты из форм подменяются случайными значениями (см. README).
# По умолчанию выключен.
# DEMO_MODE=True

# Только когда на nginx появится настоящий сертификат (см. infra/nginx.conf).
# SECURE_HSTS_SECONDS=864000

# Поднять, если перед Caddy появится ещё один прокси (например, CDN).
# TRUSTED_PROXY_HOPS=1

DB_ENGINE=postgres
DB_HOST=db
DB_PORT=5432
# Эти три читает и контейнер postgres (создаёт пользователя и базу при первой
# инициализации тома pg_data), и Django. После первого запуска менять их в .env
# бесполезно - база уже создана с прежними значениями.
POSTGRES_DB=psyhelper
POSTGRES_USER=psyhelper
POSTGRES_PASSWORD=change-me

# Email-уведомления администратору о заявках на консультацию
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@psyhelper.local
ADMIN_NOTIFICATION_EMAIL=admin@psyhelper.local

# Telegram-уведомления администратору о заявках на консультацию
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
